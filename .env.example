# Public browser configuration (not required in demo mode)
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SENTRY_DSN=

# Server-only configuration (required only when the corresponding production stage begins)
SUPABASE_SERVICE_ROLE_KEY=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=
R2_PRESIGNED_UPLOAD_TTL_SECONDS=300
R2_PRESIGNED_DOWNLOAD_TTL_SECONDS=300
R2_MAX_FILE_SIZE_BYTES=10485760
DOCUMENT_AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_DOCUMENT_MODEL=gemini-3.1-flash-lite
RESEND_API_KEY=
RESEND_FROM_EMAIL=
CRON_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
# Meta Graph API version; update deliberately when Meta deprecates a version.
WHATSAPP_GRAPH_API_VERSION=v25.0
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# Meta app secret used only on the server to verify X-Hub-Signature-256.
WHATSAPP_APP_SECRET=
# Approved utility template. Its CTA must link to the tenant-safe Note It renewals route.
WHATSAPP_EXPIRY_TEMPLATE_NAME=document_expiry_summary
WHATSAPP_EXPIRY_TEMPLATE_LANGUAGE=en
SENTRY_DSN=

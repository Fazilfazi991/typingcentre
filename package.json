{
  "name": "renewtrack",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "start": "next start",
    "build": "next build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db --local supabase/tests",
    "db:types:local": "supabase gen types --local --schema public > src/types/database.generated.ts",
    "db:types:linked": "supabase gen types --linked --schema public > src/types/database.generated.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1105.0",
    "@aws-sdk/s3-request-presigner": "^3.1105.0",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.57.0",
    "exceljs": "^4.4.0",
    "next": "^15.5.22",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "resend": "^6.18.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.5.22",
    "prettier": "^3.4.2",
    "supabase": "2.111.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
